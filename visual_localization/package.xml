<?xml version="1.0"?>
<package format="2">
    <name>visual_localization</name>
    <version>0.0.1</version>
    <description>ROS1 wrapper node for visual localization with stereo images.</description>


    <maintainer email="664956261@qq.com">zhang cheng</maintainer>
    <license>BSD</license>


    <buildtool_depend>catkin</buildtool_depend>


    <depend>roscpp</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>cv_bridge</depend>
    <depend>image_transport</depend>
    <depend>message_filters</depend>
    <depend>tf</depend>


    <exec_depend>opencv4</exec_depend>
</package>